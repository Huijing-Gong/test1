Shader "Custom/PortalScan"
{
    // Learning references for URP handwritten vertex/fragment shaders:
    // https://www.youtube.com/watch?v=KVWsAL37NGw
    // https://www.youtube.com/watch?v=gY1Mx4kkZPU

    // Reference for exposed ShaderLab material properties:
    // https://docs.unity3d.com/Manual/SL-Properties.html
    
    Properties
    {
        [HDR] _Tint("Energy Colour", Color) = (0.08, 0.8, 1, 1)
        [HDR] _EdgeColor("Edge Colour", Color) = (0.55, 1, 1, 1)

        _Reveal("Reveal Progress", Range(0, 1)) = 1
        _Intensity("Intensity", Range(0, 5)) = 1.2
        _Opacity("Surface Opacity", Range(0, 1)) = 0.23
        _EdgeWidth("Reveal Edge Width", Range(0.005, 0.15)) = 0.035
        _GridScale("Grid Density", Range(2, 40)) = 12
        _FlowSpeed("Flow Speed", Range(0, 3)) = 0.65
        _RimWidth("Portal Border Width", Range(0.005, 0.1)) = 0.026
    }

    SubShader//render state and GPU program
    {
        Tags
        {
            "RenderType" = "Transparent"
            "Queue" = "Transparent"
            "RenderPipeline" = "UniversalPipeline" //Limited URP
        }

        Pass
        {
            //rendering sitting
            Tags { "LightMode" = "SRPDefaultUnlit" } //colors generated by the Shader, without reading the scene lights

            // Reference for transparent additive blending:
            // https://docs.unity3d.com/Manual/SL-Blend.html
            Blend SrcAlpha One //result = source.rgb * source.alpha + destination.rgb * 1 Add the energy color to the background
            ZWrite Off // depth writing
            Cull Off //renders both sides

            // Reference for handwritten URP Unlit shader structure:
            // https://docs.unity3d.com/Manual/urp/writing-shaders-urp-basic-unlit-structure.html
            HLSLPROGRAM //HLSL GPU program

            #pragma vertex vert // Vertex Shader entrance
            #pragma fragment frag // Fragment Shader entrance
            #pragma target 3.0

            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

            CBUFFER_START(UnityPerMaterial) //declaring each material's own constant data
                float4 _Tint;
                float4 _EdgeColor;
                float _Reveal;
                float _Intensity;
                float _Opacity;
                float _EdgeWidth;
                float _GridScale;
                float _FlowSpeed;
                float _RimWidth;
            CBUFFER_END

            struct Attributes
            {
                float4 positionOS : POSITION; //portal position
                float2 uv : TEXCOORD0; //ux coordinates from mesh -> xy
            };

            struct Varyings //Vertax shader -> fragment shader
            {
                float4 positionCS : SV_POSITION; //transformed vertax position in clip space
                float2 uv : TEXCOORD0; //passes interpolated UV coordinates to the fragment shader.
            };

            // Reference for URP object-to-clip-space transformations:
            // https://docs.unity3d.com/Manual/urp/use-built-in-shader-methods-transformations.html
            Varyings vert(Attributes input)
            {
                Varyings output; // container

                output.positionCS =
                    TransformObjectToHClip(input.positionOS.xyz);

                output.uv = input.uv;

                return output;//returns the vertex shader output containing the transformed position and UV
            }

            float4 frag(Varyings input) : SV_Target //declares the fragment shader function
            {
                float2 uv = input.uv; // easy to call

                // Reference for Unity built-in shader time variables:
                // https://docs.unity3d.com/2023.2/Documentation/Manual/SL-UnityShaderVariables.html
                float time = _Time.y * _FlowSpeed; //time = UnityTime * FlowSpeed  - generate a controlled animation time

                // Create the round-topped portal shape.
                float2 p = float2(
                    (uv.x - 0.5) * 2.0,  //Move the central value of UV from 0.5 to 0
                    uv.y * 1.7 //Adjust the height-to-width ratio of the programmed gate shape
                );
                // Establish a left-right symmetric coordinate system with the middle of the portal as the origin

                float side = abs(p.x) - 0.94;
                // Calculate the left-right symmetric gate boundaries

                float arch = length(
                    float2(p.x, max(p.y - 0.72, 0.0)) // get new y value
                ) - 0.94; //R
                //Create a door arch with a radius of 0.94 at heights of 0.72 and above; the section below that should remain vertical

                float distanceToShape =
                    max(max(side, arch), -p.y);
                // Combines the side, top, and bottom boundaries to determine whether the fragment is inside or outside the portal

                // Reference for HLSL functions including fwidth, smoothstep,
                // frac, step, clip, sin and saturate:
                // https://learn.microsoft.com/en-us/windows/win32/direct3dhlsl/dx-graphics-hlsl-intrinsic-functions
                float antiAlias =
                    max(fwidth(distanceToShape), 0.001);
                    //Make the edges look smoother

                float shape =
                    1.0 - smoothstep(
                        -antiAlias,
                        antiAlias,
                        distanceToShape
                    ); //Visible inside, not outside, only portal shape

                clip(shape - 0.001); //clips away the parts of the rectangular quad that are outside the portal’s arch shape


                //Creates a smooth glowing rim along the inside of the portal boundary
                float rim =
                    1.0 - smoothstep(
                        _RimWidth, //The position where the edge light begins to fade
                        _RimWidth + antiAlias, //The position where the smooth transition ends
                        -distanceToShape //distanceToShape < 0 -> portal inside
                    );

                // Reveal the surface from bottom to top, Calculate scan height
                float threshold =
                    lerp(-0.2, 1.2, _Reveal); //Take a value proportional to the difference between two numbers

                float revealWave =
                    sin(uv.x * 18.0 + time * 2.0) * 0.025;
                    //Generate a horizontal wave along the scanned edge

                float difference =
                    threshold - (uv.y + revealWave);
                    //Compares the scan height with the fragment height to determine whether it has been revealed

                float reveal =
                    smoothstep(0.0, 0.015, difference)
                    * step(0.0001, _Reveal);
                    //Convert the “difference” to the final reveal mask

                float revealEdge =
                    (
                        1.0 - smoothstep(
                            0.0,
                            _EdgeWidth,
                            abs(difference)
                        )
                    ) * step(0.0001, _Reveal);
                    //Generate a glowing edge that moves along the scan position

                // Create horizontal and vertical grid lines.
                float2 gridUV =
                    uv * float2(
                        _GridScale,
                        _GridScale * 1.7
                    );
                    //Zoom in on the original UVs and save them as gridUV

                float2 cellDistance =
                    abs(frac(gridUV - 0.5) - 0.5);
                    //Calculate the distance from the current element to the nearest horizontal and vertical grid lines

                float2 gridWidth = max(
                    fwidth(gridUV),
                    float2(0.001, 0.001)
                );
                //Calculate the anti-aliasing width required for horizontal and vertical grid lines

                float2 gridLines =
                    1.0 - smoothstep(
                        float2(0.025, 0.025),
                        float2(0.025, 0.025) + gridWidth,
                        cellDistance
                    );
                    //Convert cellDistance into horizontal and vertical grid line masks

                float grid =
                    max(gridLines.x, gridLines.y);
                    //Merge into a single, complete grid mask

                // Continuously moving wavy energy ribbons.
                float ribbon = pow(
                    0.5 + 0.5 * sin( //Range converted to 0–1
                        uv.x * 28.0 //Arrange multiple vertical bands of light in a repeating pattern from left to right
                        + sin(uv.y * 7.0 - time * 1.7) * 1.2 //Inner wave + Control the Degree of Bending
                        + time //wave effect
                    ),
                    8.0
                );
                //Generate an internal wave

                float pulse =
                    0.92 + 0.08 * sin(time * 3.0);
                    //Creates a brightness coefficient that varies over time, producing a light-dark transition effect

                float energy = //energy=(0.12+0.6G+0.22R+1.6M)*P),G-grid，R-ribbon, M-rim, P-pulse
                    (
                        0.12
                        + grid * 0.6
                        + ribbon * 0.22
                        + rim * 1.6
                    ) * pulse;
                    //Combines the base glow, grid, ribbons, and rim, then applies the brightness pulse

                float3 colour =
                    (
                        _Tint.rgb * energy//color light
                        + _EdgeColor.rgb * revealEdge * 2.4 //make the edge become more light
                    ) * _Intensity; //light effect

                float alpha =
                    shape * saturate( //(saturate(x)=min(max(x,0),1))
                        reveal //Control When the Portal Body Is Visible
                        * (
                            _Opacity//Base Transparency of the Portal's Surface
                            + grid * 0.18 //Make the grid lines more opaque and more visible than on a regular surface
                            + rim * 0.7 //Make the outer edge of the door noticeably more opaque
                        )
                        + revealEdge * 0.9 //control edge's opacity
                    );

                return float4(colour, alpha);//Returns the final RGB colour and alpha value to the render target
            }

            ENDHLSL
        }
    }

    Fallback Off //no replacement
}
